<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- LISTA -->
  <record id="view_assistec_discount_tree" model="ir.ui.view">
    <field name="name">assistec.discount.tree</field>
    <field name="model">assistec.discount</field>
    <field name="arch" type="xml">
      <list editable="bottom" string="Catálogo de descontos">
        <field name="active"/>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="discount_type"/>
        <field name="discount_value"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>

  <!-- FORM -->
  <record id="view_assistec_discount_form" model="ir.ui.view">
    <field name="name">assistec.discount.form</field>
    <field name="model">assistec.discount</field>
    <field name="arch" type="xml">
      <form string="Regra de Desconto">
        <sheet>
          <group>
            <group>
              <field name="active"/>
              <field name="sequence"/>
              <field name="name" required="1"/>
            </group>
            <group>
              <field name="discount_type" required="1"/>
              <field name="discount_value" required="1" digits="Product Price"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- AÇÃO (usada pelo botão nas Configurações) -->
  <record id="action_assistec_discount" model="ir.actions.act_window">
    <field name="name">Regras de descontos</field>
    <field name="res_model">assistec.discount</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_active': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Nenhuma regra cadastrada ainda.
      </p>
      <p>Cadastre regras reutilizáveis (percentual, fixo, preço por unidade) para aplicar nas linhas da OS.</p>
    </field>
  </record>
</odoo>
