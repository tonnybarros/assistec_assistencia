<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ===== HERANÇA: Oculta header/footer se hide_header/hide_footer definidos -->
  <template id="website_layout_no_header_footer" inherit_id="website.layout">
    <xpath expr="//header" position="attributes">
      <attribute name="t-if">not hide_header</attribute>
    </xpath>
    <xpath expr="//footer" position="attributes">
      <attribute name="t-if">not hide_footer</attribute>
    </xpath>
  </template>

  <!-- ================= TEMPLATE: FORMULÁRIO ================= -->
  <template id="os_status_form" name="Consulta de OS">
    <t t-call="website.layout">
      <t t-set="hide_header" t-value="True"/>
      <t t-set="hide_footer" t-value="True"/>

      <section class="container my-5">
        <div class="row justify-content-center">
          <div class="col-md-7 col-lg-6">
            <h2 class="mb-4 text-primary">Acompanhe sua OS</h2>

            <form action="/os/status" method="post" autocomplete="off"
                  class="bg-light rounded p-4 shadow-sm">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

              <div class="mb-3">
                <label for="os_number" class="form-label">Número da OS</label>
                <input name="os_number" id="os_number" required="required"
                       class="form-control"/>
              </div>

              <div class="mb-3">
                <label for="phone" class="form-label">
                  Celular cadastrado (ex: 21998765432)
                </label>
                <input name="phone" id="phone" required="required" maxlength="11"
                       pattern="\d{11}" class="form-control"/>
              </div>

              <button type="submit" class="btn btn-primary w-100">
                Consultar andamento
              </button>
            </form>
          </div>
        </div>
      </section>
    </t>
  </template>

  <!-- ================= TEMPLATE: RESULTADO ================= -->
  <template id="os_status_result" name="Resultado Consulta OS">
    <t t-call="website.layout">
      <t t-set="hide_header" t-value="True"/>
      <t t-set="hide_footer" t-value="True"/>

      <section class="container my-5">
        <div class="row justify-content-center">
          <div class="col-md-9 col-lg-8">
            <a href="/os/status" class="btn btn-link mb-4">← Nova consulta</a>

            <!-- erros -->
            <t t-if="errors">
              <t t-foreach="errors" t-as="err">
                <div class="alert alert-danger mb-4" t-esc="err"/>
              </t>
            </t>

            <!-- resultado -->
            <t t-elif="order">
              <div class="p-4 bg-white rounded shadow-sm">
                <!-- Cabeçalho OS -->
                <h2 class="mb-2 text-success">
                  OS <span t-esc="order.name"/> 
                  <br/><span t-esc="order.stage_id.name"/>
                </h2>
                <p class="mb-3 text-muted">
                  Acompanhe aqui o andamento da sua ordem de serviço. Em caso de dúvidas, fale conosco!
                </p>

                <!-- Fluxo/etapas -->
                <div class="mb-4">
                  <ol class="list-unstyled d-flex flex-row flex-wrap gap-3">
                    <li>
                      <span class="badge rounded-pill bg-primary">Entrada</span><br/>
                      <small>
                        <t t-if="order.date_in">
                          <span t-field="order.date_in"
                                t-options="{'widget':'date','format':'dd/MM/yyyy'}"/>
                        </t>
                        <t t-else="">—</t>
                      </small>
                    </li>
                    <li>
                      <span class="badge rounded-pill bg-info">Status atual</span><br/>
                      <small><span t-esc="order.stage_id.name"/></small>
                    </li>
                    <li>
                      <span class="badge rounded-pill bg-warning">Previsão</span><br/>
                      <small>
                        <t t-if="order.delivery_date">
                          <span t-field="order.delivery_date"
                                t-options="{'widget':'date','format':'dd/MM/yyyy'}"/>
                        </t>
                        <t t-else="">—</t>
                      </small>
                    </li>
                    <t t-if="order.date_out">
                      <li>
                        <span class="badge rounded-pill bg-success">Finalizado</span><br/>
                        <small>
                          <span t-field="order.date_out"
                                t-options="{'widget':'date','format':'dd/MM/yyyy'}"/>
                        </small>
                      </li>
                    </t>
                  </ol>
                </div>

                <!-- Dados do Aparelho/OS -->
                <div class="mb-3">
                  <strong>Cliente:</strong>
                  <span t-esc="order.partner_id.name.split(' ')[0]"/>
                  <br/><strong>Aparelho:</strong>
                  <span t-esc="order.repair_product_id.display_name"/>
                  <t t-if="order.brand_id">, <span t-esc="order.brand_id.display_name"/></t>
                  <t t-if="order.model">, <span t-esc="order.model"/></t>
                  <t t-if="order.serial_number">
                    <br/><strong>Nº de Série:</strong>
                    <span t-esc="order.serial_number"/>
                  </t>
                  <br/>
                  <strong>Defeito:</strong> <span t-esc="order.issue_description"/>
                  <t t-if="order.accessories">
                    <br/><strong>Acessórios:</strong>
                    <span t-esc="order.accessories"/>
                  </t>
                </div>

                <!-- Total informal -->
                <div class="mb-3">
                  <strong>Total estimado:</strong>
                  <span class="text-success fs-5 fw-bold"
                        t-field="order.amount_total"
                        t-options="{'widget':'monetary','display_currency': order.currency_id}"/>
                  <t t-if="order.amount_discount and order.amount_discount &gt; 0">
                    <span class="ms-2 text-danger small">
                      (Descontos aplicados!)
                    </span>
                  </t>
                </div>

                <!-- BOTÕES DE DECISÃO (aparecem só com valor > 0) -->
                <t t-if="token
                         and order.amount_total and order.amount_total &gt; 0
                         and order.stage_id.code not in ['autorizado','nao_autorizado']">
                  <div class="mb-4">
                    <!-- Aprovar -->
                    <form t-att-action="'/os/%s/approve' % token"
                          method="post" style="display:inline;">
                      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                      <button class="btn btn-success me-2">✅ Autorizo</button>
                    </form>

                    <!-- Reprovar -->
                    <form t-att-action="'/os/%s/reject' % token"
                          method="post" style="display:inline;">
                      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                      <button class="btn btn-danger">❌ Não autorizo</button>
                    </form>
                  </div>
                </t>
                <t t-elif="order.stage_id.code == 'autorizado'">
                  <div class="alert alert-success mb-4">
                    Você já autorizou o orçamento. Obrigado!
                  </div>
                </t>
                <t t-elif="order.stage_id.code == 'nao_autorizado'">
                  <div class="alert alert-danger mb-4">
                    Você indicou que não autoriza o orçamento.
                  </div>
                </t>

                <!-- Serviços, informal -->
                <div class="mb-3">
                  <strong>Serviços incluídos:</strong>
                  <ul class="list-group list-group-flush">
                    <t t-if="order.line_ids">
                      <t t-foreach="order.line_ids" t-as="l">
                        <li class="list-group-item px-0">
                          <b><t t-esc="l.service_id.display_name"/></b>
                          <t t-if="l.description">
                            — <span t-esc="l.description"/>
                          </t>
                        </li>
                      </t>
                    </t>
                    <t t-else="">
                      <li class="list-group-item px-0 text-muted">
                        Sem serviços cadastrados.
                      </li>
                    </t>
                  </ul>
                </div>

                <!-- Imagens anexadas -->
                <!-- Anexos (imagens ou documentos) -->
                <t t-if="order.image_ids">
                  <div class="mb-4">
                    <strong>Arquivos anexados:</strong>
                    <div class="row g-2 mt-2">
                      <t t-foreach="order.image_ids" t-as="att">
                        <!-- Imagem: thumbnail clicável -->
                        <t t-if="att.mimetype and att.mimetype.startswith('image/')">
                          <div class="col-4 col-md-3 col-lg-2">
                            <a t-att-href="'/web/image/%s' % att.id" target="_blank">
                              <img t-att-src="'/web/image/%s' % att.id"
                                  class="img-fluid rounded border"
                                  alt="Imagem anexada"
                                  style="cursor: zoom-in;"/>
                            </a>
                          </div>
                        </t>
                        <!-- Documento: link para download/visualização -->
                        <t t-else="">
                          <div class="col-12">
                            <a t-att-href="'/web/content/%s?download=true' % att.id"
                              target="_blank"
                              class="btn btn-outline-secondary btn-sm">
                              <i class="fa fa-paperclip me-1"></i>
                              <span t-esc="att.name or 'Download'"/>
                            </a>
                          </div>
                        </t>
                      </t>
                    </div>
                  </div>
                </t>

                <!-- Observações finais -->
                <t t-if="order.notes">
                  <div class="mt-3 p-3 bg-light rounded">
                    <strong>Observações:</strong>
                    <div class="text-muted" t-esc="order.notes"/>
                  </div>
                </t>

                <!-- Contato final -->
<t t-set="empresa_whatsapp" t-value="(request.website.company_id.mobile or request.website.company_id.phone or '').replace('(', '').replace(')', '').replace('-', '').replace(' ', '')"/>
<div class="mt-4 small text-muted">
  Dúvidas? Fale conosco pelo
  <t t-if="empresa_whatsapp and len(empresa_whatsapp) >= 10">
    <a t-att-href="'https://wa.me/55%s' % empresa_whatsapp" target="_blank" class="fw-bold text-success" style="text-decoration:underline;">
      WhatsApp
    </a>
    ou telefone cadastrado.
  </t>
  <t t-else="">
    WhatsApp ou telefone cadastrado.
  </t>
</div>
              </div>
            </t>
          </div>
        </div>
      </section>
    </t>
  </template>
</odoo>
