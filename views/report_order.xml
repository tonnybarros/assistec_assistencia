            .num { text-align:center; font-weight:700; font-size:18px; }
            .small { font-size:11px; }
          </style>

          <div class="assistec-a4">
            <div class="hdr">
              <t t-set="hdr" t-value="env['ir.config_parameter'].sudo().get_param('assistec.report_head_]()
