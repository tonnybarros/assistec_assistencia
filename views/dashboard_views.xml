<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 1) TEMPLATE QWEB onde o componente OWL será montado -->
    <record id="template_assistec_dashboard" model="ir.ui.view">
        <field name="name">assistec.dashboard.template</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="assistec.Dashboard">
                <div class="o_assistec_dashboard"/>
            </t>
        </field>
    </record>

    <!-- 2) CLIENT ACTION (OWL) -->
    <record id="action_assistec_dashboard_client" model="ir.actions.client">
        <field name="name">Painel de Controle</field>
        <field name="tag">assistec_dashboard_client</field>
    </record>

</odoo>
