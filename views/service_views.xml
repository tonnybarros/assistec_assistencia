<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
  <record id="view_assistec_service_tree" model="ir.ui.view">
    <field name="name">assistec.service.tree</field>
    <field name="model">assistec.service</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="list_price"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_assistec_service_form" model="ir.ui.view">
    <field name="name">assistec.service.form</field>
    <field name="model">assistec.service</field>
    <field name="arch" type="xml">
      <form string="Serviço">
        <sheet>
          <group>
            <field name="name"/>
            <field name="list_price"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</data>
</odoo>