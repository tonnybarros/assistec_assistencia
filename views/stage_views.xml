<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- TREE -->
  <record id="view_assistec_stage_tree" model="ir.ui.view">
    <field name="name">assistec.stage.tree</field>
    <field name="model">assistec.stage</field>
    <field name="arch" type="xml">
      <list string="Situações" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="ui_class"/>
        <field name="is_default"/>
        <field name="mark_repaired"/>
        <field name="mark_closed"/>
        <field name="is_cancel"/>
        <field name="active"/>
        <field name="company_id" optional="hide" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>

  <!-- FORM -->
  <record id="view_assistec_stage_form" model="ir.ui.view">
    <field name="name">assistec.stage.form</field>
    <field name="model">assistec.stage</field>
    <field name="arch" type="xml">
      <form string="Estágio">
        <sheet>
          <group col="4">
            <field name="name"/>
            <field name="code" placeholder="ex.: draft, confirmed, in_progress..."/>
            <field name="sequence"/>
            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
            <field name="ui_class"/>
            <field name="is_default"/>
            <field name="active"/>
          </group>

          <group string="Gatilhos automáticos">
            <field name="mark_repaired"/>
            <field name="mark_closed"/>
            <field name="is_cancel"/>
          </group>

          <!-- Cabeçalho informativo compatível (sem <label for=...>) -->
          <div class="o_form_label text-muted">Dica:</div>
          <div class="text-muted">
            Use <b>code</b> com valores livres para integrações. Se você usar
            <i>draft, confirmed, in_progress, done, cancelled</i>, os botões atuais
            da OS vão localizar automaticamente o estágio correspondente.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ACTION -->
  <record id="action_assistec_stage" model="ir.actions.act_window">
    <field name="name">Situações</field>
    <field name="res_model">assistec.stage</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
  </record>

</odoo>
