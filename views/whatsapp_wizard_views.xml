<odoo>
  <!-- View do wizard -->
  <record id="view_assistec_whatsapp_wizard" model="ir.ui.view">
    <field name="name">assistec.whatsapp.wizard.form</field>
    <field name="model">assistec.whatsapp.wizard</field>
    <field name="arch" type="xml">
      <form string="Enviar WhatsApp">
        <group>
          <field name="order_id" invisible="1"/>
          <field name="partner_id" readonly="1"/>
          <field name="partner_mobile"/>
          <field name="message" placeholder="Digite a mensagem..."/>
        </group>
        <footer>
          <button name="action_send_whatsapp" string="Enviar" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Server Action que aparece na engrenagem e abre o modal -->
  <record id="action_assistec_whatsapp_server" model="ir.actions.server">
    <field name="name">Enviar WhatsApp</field>
    <field name="model_id" ref="assistec_assistencia.model_assistec_order"/>
    <field name="binding_model_id" ref="assistec_assistencia.model_assistec_order"/>
    <field name="binding_view_types">form</field>
    <field name="state">code</field>
    <field name="code">action = records.action_open_whatsapp_modal()</field>
  </record>
</odoo>
