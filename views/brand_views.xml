<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
  <record id="view_assistec_brand_tree" model="ir.ui.view">
    <field name="name">assistec.brand.tree</field>
    <field name="model">assistec.brand</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_assistec_brand_form" model="ir.ui.view">
    <field name="name">assistec.brand.form</field>
    <field name="model">assistec.brand</field>
    <field name="arch" type="xml">
      <form string="Marca">
        <sheet>
          <group>
            <field name="name"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</data>
</odoo>