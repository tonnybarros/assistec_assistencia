<?xml version="1.0" encoding="UTF-8"?>
<templates id="tmpl" xml:space="preserve">
    <!-- acrescenta target="_blank" e redireciona para o método JS acima -->
    <t t-name="assistec_assistencia.m2m_binary_preview"
       t-inherit="web.Many2ManyBinaryField.attachment_preview"
       t-inherit-mode="extension">
        <!-- miniatura -->
        <xpath expr="//div[hasclass('o_image_box', 'float-start')]//a" position="attributes">
            <attribute name="target">_blank</attribute>
            <attribute name="t-on-click.stop.prevent">() => this.onClickURL(file.id)</attribute>
        </xpath>
        <!-- legenda / link do nome -->
        <xpath expr="//div[hasclass('caption')]//a" position="attributes">
            <attribute name="target">_blank</attribute>
            <attribute name="t-on-click.stop.prevent">() => this.onClickURL(file.id)</attribute>
        </xpath>
    </t>
</templates>
